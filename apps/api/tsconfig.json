{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "noEmitOnError": true,
    "paths": {
      "@PROJECT_NAME/types": ["../../packages/types/src/index.ts"],
      "@PROJECT_NAME/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
